    end
end

local function createTextLabel(parent, text, size, position, font, textSize, color, alignment)
    local label = make("TextLabel", {
        Parent = parent,
        Size = size,
        Position = position,
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color or Color3.fromRGB(245,245,245),
        Font = font or Enum.Font.GothamBold,
        TextSize = textSize or 18,
        TextXAlignment = alignment or Enum.TextXAlignment.Left,
        TextWrapped = true,
    })
    return label
end

local function createTextButton(parent, text, size, position, fontSize, callback)
    local btn = make("TextButton", {
        Parent = parent,
        Size = size,
        Position = position,
        BackgroundColor3 = Color3.fromRGB(30,33,40),
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = Color3.fromRGB(245,245,245),
        Font = Enum.Font.GothamBold,
        TextSize = fontSize or 14,
        AutoButtonColor = false,
        TextWrapped = true,
    })

    applyCorner(btn, 10)
    applyStroke(btn, Color3.fromRGB(230,58,58), 1)

    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(52,52,58)
    end)

    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(30,33,40)
    end)

    if callback then
        btn.MouseButton1Click:Connect(function()
            doWithGuard(callback)
        end)
    end

    return btn
end

