end

local function createTargetHighlight(character)
    if targetHighlightMap[character] then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0.15
    highlight.FillColor = Color3.fromRGB(255, 70, 70)
    highlight.OutlineColor = Color3.fromRGB(255, 90, 90)
    highlight.Adornee = character
    highlight.Parent = Workspace
    targetHighlightMap[character] = highlight
end

local function getNearestTarget()
    local nearestInfo = nil

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character and other.Character:FindFirstChild("Humanoid") and other.Character.Humanoid.Health > 0 then
            local root = other.Character:FindFirstChild("HumanoidRootPart")
            local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if root and localRoot then
                local distance = (root.Position - localRoot.Position).Magnitude
                if distance <= 120 then
                    local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local dirToTarget = (root.Position - camera.CFrame.Position)
                        local viewDir = camera.CFrame.LookVector
                        local dot = dirToTarget.Unit:Dot(viewDir)
                        if dot > 0.5 then
                            if not nearestInfo or distance < nearestInfo.distance then
                                nearestInfo = {
                                    name = other.Name,
                                    distance = distance,
                                    screenPos = Vector2.new(screenPos.X, screenPos.Y),
                                    character = other.Character,
                                }
                            end
                        end
                    end
                end
            end
        end
    end

    return nearestInfo
end

