local function triggerClickPulse()
    if not state.autoClickEnabled then
        return
    end

    autoClickUI.pulseNode.Visible = true
    autoClickUI.pulseNode.Size = UDim2.new(0, 32, 0, 32)

    local t = 0
    local connection

    connection = RunService.RenderStepped:Connect(function(dt)
        t += dt
        autoClickUI.pulseNode.Size = UDim2.new(0, 32 + t * 90, 0, 32 + t * 90)
        autoClickUI.pulseNode.Position = UDim2.new(0.5, -(16 + t * 45), 0.5, -(16 + t * 45))
        autoClickUI.pulseNode.BackgroundTransparency = 0.15 + (t * 0.7)
        if t >= 0.18 then
            autoClickUI.pulseNode.Visible = false
            connection:Disconnect()
        end
    end)
end

local function startAutoClicker()
    if autoClickTask then
        return
    end

    autoClickUI.pulseNode.Visible = true
    autoClickTask = task.spawn(function()
        while state.autoClickEnabled do
            triggerClickPulse()
            task.wait(1 / 20)
        end
    end)
end

local function stopAutoClicker()
    if autoClickTask then
        task.cancel(autoClickTask)
        autoClickTask = nil
    end

    autoClickUI.pulseNode.Visible = false
end

