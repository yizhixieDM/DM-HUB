local function make(className, props)
    local obj = Instance.new(className)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    return obj
end

local function applyCorner(instance, radius)
    local corner = make("UICorner", {
        CornerRadius = UDim.new(0, radius),
    })
    corner.Parent = instance
end

local function applyStroke(instance, color, thickness)
    local stroke = make("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = color,
        Thickness = thickness or 1,
        Transparency = 0.14,
    })
    stroke.Parent = instance
end

local function applyGradient(instance, colorA, colorB)
    local gradient = make("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, colorA),
            ColorSequenceKeypoint.new(1, colorB),
        }),
    })
    gradient.Parent = instance
end

local function doWithGuard(fn)
    if state.executing then
        return
    end

    state.executing = true
    local ok, err = xpcall(fn, debug.traceback)
    if not ok then
        warn("doWithGuard error:", err)
    end

    task.delay(0.25, function()
        state.executing = false
    end)
end

local function setPageVisible()
