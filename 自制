local function createSwitch(parent, initialOn, callback)
    local switchFrame = make("Frame", {
        Parent = parent,
        Size = UDim2.new(0, 52, 0, 28),
        BackgroundColor3 = Color3.fromRGB(25,27,32),
        BorderSizePixel = 0,
    })
    applyCorner(switchFrame, 999)

    local on = initialOn
    local knob = make("Frame", {
        Parent = switchFrame,
        Size = UDim2.new(0, 18, 0, 18),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
        Position = on and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
    })
    applyCorner(knob, 999)

    local function refresh()
        if on then
            switchFrame.BackgroundColor3 = Color3.fromRGB(217,43,43)
            knob:TweenPosition(UDim2.new(1, -21, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.18, true)
        else
            switchFrame.BackgroundColor3 = Color3.fromRGB(25,27,32)
            knob:TweenPosition(UDim2.new(0, 3, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.18, true)
        end

        if callback then
            callback(on)
        end
    end

    switchFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            on = not on
            refresh()
        end
    end)

    refresh()
    return switchFrame
end

local function createRoundImageIcon(parent, size, position, imageId)
    local bg = make("Frame", {
        Parent = parent,
        Size = size,
        Position = position,
        BackgroundColor3 = Color3.fromRGB(25,27,32),
        BorderSizePixel = 0,
    })
    applyCorner(bg, 999)
    applyStroke(bg, Color3.fromRGB(230,58,58), 1)

    local image = make("ImageLabel", {
        Parent = bg,
        Size = UDim2.new(1, -8, 1, -8),
        Position = UDim2.new(0, 4, 0, 4),
        BackgroundTransparency = 1,
        Image = imageId,
        ScaleType = Enum.ScaleType.Fit,
        BorderSizePixel = 0,
    })

    return bg, image
end

